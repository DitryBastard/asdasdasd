# Copy this file to .env and adjust as needed.

# Ollama must be running locally with these two models pulled:
#   ollama pull qwen2.5:14b-instruct
#   ollama pull bge-m3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:14b-instruct
OLLAMA_EMBED_MODEL=bge-m3

# Where the local translation-memory vector database is persisted on disk.
CHROMA_PERSIST_DIR=./data/chroma

# Where the glossary/termbase (mandatory terminology) is stored - a plain
# JSON file, separate from the translation memory above (see
# app/glossary_store.py for why).
GLOSSARY_PATH=./data/glossary.json

# Cosine similarity thresholds (0-1) for translation-memory matches.
# >= EXACT: the stored translation is reused as-is (no model call).
# >= FUZZY and < EXACT: shown to the model as a reference example.
# < FUZZY: ignored.
EXACT_MATCH_THRESHOLD=0.98
FUZZY_MATCH_THRESHOLD=0.75
TOP_K_MATCHES=3

# Max sentences sent to the model in a single translation request.
BATCH_SIZE=20

# Max characters of document text sent to the chat model in a single
# document-pair alignment call (see app/llm_alignment.py) - larger means
# fewer chunks and better alignment quality (more context per call) at the
# cost of a longer prompt.
LLM_ALIGNMENT_MAX_CHARS=12000

# Max gap (PDF points) between characters before pdfplumber treats them as
# separate words when extracting text for document-pair alignment. Lower
# catches tighter word gaps (fixes words glued together, e.g.
# "wasdevelopedin") but risks splitting some legitimately tight character
# pairs into extra spaces instead - this is font/document-specific, so if
# you see either problem on real documents, adjust it here.
PDF_TEXT_X_TOLERANCE=1.5

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173
